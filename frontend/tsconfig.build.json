{
  "extends": "./tsconfig.json",
  // Tests are not deployed, so they have no business being able to break a
  // deploy. `npm run typecheck` does cover them — that is where they matter.
  //
  // This also avoids dragging vitest into the production dependencies just so
  // `tsc` finds its types when compiling.
  //
  // Nor the runner's own configuration: `vitest.config.ts` went into the base
  // tsconfig's `include` so the lint would analyse it with types, and from
  // there it was inherited by this one. The server has no `vitest` at build
  // time, and the production build fell over on the file of a runner that is
  // not deployed. It happened on 4 October 2026.
  //
  // And the whole of `src/test-support/`: they are the helpers the tests
  // share, and one of them imports `vitest`. It happened again on 5 October
  // 2026 with `app-falsa.ts`; an excluded folder is not forgotten like a suffix.
  //
  // And the component catalog: Storybook is a devDependency, so neither its
  // stories nor its configuration can enter the production build.
  //
  // The same for Orval (`orval.config.ts`): the client it writes is versioned
  // and the server does not regenerate it, so Orval is a devDependency.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.tsx",
    "src/test-support",
    ".storybook",
    "vitest.config.ts",
    "orval.config.ts",
    "dist",
    "node_modules"
  ]
}
