# ─────────────────────────────────────────────────────────────
# Configuración de Apache para la SPA. Vive en `public/` para que Vite la
# copie a `dist/` y viaje siempre con el sitio: si estuviera solo en el
# servidor, el primer despliegue que use --delete la borraría.
# ─────────────────────────────────────────────────────────────

# ── Enrutamiento de la SPA ───────────────────────────────────
# React Router maneja las rutas en el cliente. Sin esto, entrar directo a
# /movimientos o recargar la página daría un 404 de Apache: ese archivo no
# existe en disco.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /api/ se deja pasar tal cual: lo atiende el proceso Node, no la SPA.
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Lo que exista en disco se sirve tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás lo resuelve la SPA.
  RewriteRule . /index.html [L]
</IfModule>

# ── Cabeceras de seguridad ───────────────────────────────────
# Las mismas que pone helmet en la API. Aquí hacen falta aparte porque estos
# archivos los sirve Apache directamente, sin pasar por Node.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Los nombres de archivo llevan hash: un cambio produce un nombre nuevo, así
  # que el contenido se puede cachear para siempre sin miedo.
  <FilesMatch "\.(js|mjs|css|woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html NO se cachea: es lo que apunta a los assets nuevos tras un
  # despliegue. Si se cacheara, la gente seguiría cargando la versión vieja.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compresión ───────────────────────────────────────────────
# Importa especialmente para los recursos de Tesseract: el WASM viene incrustado
# en base64 y sin comprimir son 3,7 MB por descarga.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Nada de listados de directorio ───────────────────────────
Options -Indexes
