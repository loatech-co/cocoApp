# ─────────────────────────────────────────────────────────────
# frontend/.env.example — plantilla SIN valores reales.
#
# Vite solo expone al bundle las variables con prefijo VITE_, y TODO lo que
# lleve ese prefijo es público: viaja en el JavaScript que descarga el
# navegador. Aquí nunca va un secreto.
#
# La autenticación no necesita ninguna clave en el cliente: el access token se
# obtiene al entrar y vive en memoria, y el refresh token viaja en una cookie
# httpOnly que el JavaScript ni siquiera puede leer.
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL="http://localhost:3000/api/v1"
