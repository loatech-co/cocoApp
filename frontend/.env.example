# ─────────────────────────────────────────────────────────────
# frontend/.env.example — template with NO real values.
#
# Vite only exposes to the bundle the variables prefixed VITE_, and EVERYTHING
# with that prefix is public: it travels in the JavaScript the browser
# downloads. A secret never goes here.
#
# Authentication needs no key in the client: the access token is obtained at
# sign-in and lives in memory, and the refresh token travels in an httpOnly
# cookie that the JavaScript cannot even read.
# ─────────────────────────────────────────────────────────────

# Only the origin: the generated client's paths already carry their /api/v2.
VITE_API_ORIGIN="http://localhost:3000"
