# ─────────────────────────────────────────────────────────────
# frontend/.env.example — plantilla SIN valores reales.
#
# Ojo con la diferencia: la configuración de Firebase del CLIENTE es pública
# por diseño (viaja en el bundle y cualquiera puede leerla); quien protege los
# datos es la verificación del token en el backend, no ocultar estas claves.
# Lo que JAMÁS va aquí es el service account de Firebase Admin: ese vive solo
# en api/.env.
#
# Vite solo expone al bundle las variables con prefijo VITE_.
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL="http://localhost:3000/api/v1"

VITE_FIREBASE_API_KEY="__CAMBIAR__"
VITE_FIREBASE_AUTH_DOMAIN="__CAMBIAR__.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="__CAMBIAR__"
VITE_FIREBASE_STORAGE_BUCKET="__CAMBIAR__.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="__CAMBIAR__"
VITE_FIREBASE_APP_ID="__CAMBIAR__"
