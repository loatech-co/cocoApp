# ─────────────────────────────────────────────────────────────
# Coco — personal finances
# Unbreakable rule (PRD 23.10): no secret enters the git history.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# frontend/.env.production IS versioned. It is not a careless exception:
# EVERYTHING prefixed VITE_ ends up inside the JavaScript the browser
# downloads, so by definition there cannot be a secret there. Versioning it is
# what makes the production build reproducible.
!frontend/.env.production
# The local auth server's key and accounts (`npm run dev:auth`).
api/.dev-auth.json
*.key
*.pem
*.p12
*.pfx

# Firebase Admin credentials (service account) — NEVER to the repo
**/serviceAccount*.json
**/firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json

# Build
dist/
build/
storybook-static/
.vite/
*.tsbuildinfo

# Prisma: the migrations ARE versioned; the generated client is not
# (Prisma 7 writes it to api/src/generated; `prisma generate` rebuilds it)
api/src/generated/
api/prisma/*.db
api/prisma/*.db-journal

# Backups and dumps (PRD 6.7)
*.sql.gz
*.sql.gz.enc
/backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Operating system
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Tesseract assets: scripts/prepare-tesseract.mjs generates them.
# They are reproducible artifacts, not source.
frontend/public/tesseract/

# The source images ARE versioned: they are the original that what is
# published comes from, and losing them would force recompressing from an
# already compressed WebP.

# Real financial data and the database backups do NOT live here: they are in
# $COCO_DATA_DIR, outside the repository (see docs/runbook.md). Only the
# project lives inside the project's folder.

# Receipts: real receipts. Never to the repository, not even by accident.
api/.soportes/
api/.soportes-test/
api/.receipts-test/
soportes-origen/

# `@coco/receipt-parser` compiles to CommonJS so the API imports it at run
# time; the frontend reads it from source through an alias. The compiled output
# is not versioned: `postinstall` and `build` produce it.
packages/receipt-parser/dist/

# The executors' worktrees (Claude Code): working copies, never part of the repo.
.claude/worktrees/
# Per-machine Claude Code settings (absolute paths, local permissions).
.claude/settings.local.json

# Playwright journeys: traces, screenshots and the HTML report (e2e/)
e2e/.output/
e2e/.salida/
