# ─────────────────────────────────────────────────────────────
# Balance — Finanzas Personales
# Regla inviolable (PRD 23.10): ningún secreto entra al historial de git.
# ─────────────────────────────────────────────────────────────

# Dependencias
node_modules/
.pnp
.pnp.js

# Entorno y secretos
.env
.env.*
!.env.example
!.env.*.example

# frontend/.env.production SÍ se versiona. No es una excepción descuidada: TODO
# lo que lleva prefijo VITE_ acaba dentro del JavaScript que descarga el
# navegador, así que por definición ahí no puede haber un secreto. Versionarlo
# es lo que hace que el build de producción sea reproducible.
!frontend/.env.production
*.key
*.pem
*.p12
*.pfx

# Credenciales de Firebase Admin (service account) — JAMÁS al repo
**/serviceAccount*.json
**/firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json

# Build
dist/
build/
.vite/
*.tsbuildinfo

# Prisma: las migraciones SÍ se versionan; el cliente generado no
node_modules/.prisma/
api/prisma/*.db
api/prisma/*.db-journal

# Respaldos y dumps (PRD 6.7)
*.sql.gz
*.sql.gz.enc
/backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Pruebas
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Sistema operativo
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Recursos de Tesseract: los genera scripts/preparar-tesseract.mjs.
# Son artefactos reproducibles, no fuente.
frontend/public/tesseract/
