// Firma. Este archivo SÍ se versiona y es el que referencia el .xcodeproj:
// Xcode se niega a abrir un proyecto cuya configuración base no existe, así
// que el que puede faltar no es este, sino el que incluye.
//
// `#include?` (con la interrogación) es un include OPCIONAL de xcconfig: si
// Local.xcconfig no está, se ignora en silencio y la app se compila para el
// simulador sin equipo. Si está, lo que diga pisa lo de aquí.
//
// Lo que cada quien pone en Local.xcconfig (equipo, identidad, perfil) no se
// escribe aquí ni en project.yml, porque `xcodegen generate` regenera el
// .xcodeproj y lo que se configure a mano en Signing & Capabilities se
// pierde. Ver Local.xcconfig.example.
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"
