// Copy this file as Local.xcconfig (it is in .gitignore: not versioned) and
// set your Team ID. You find it in Xcode → Settings → Accounts → your team, in
// the right-hand column, or in Signing & Capabilities after choosing it.
//
// The three targets (Coco, CocoWidgets, CocoTests) inherit it from the
// project. After changing it there is no need to regenerate: Xcode reads the
// xcconfig on every build. Regenerating (`xcodegen generate`) is needed if
// project.yml was touched.
DEVELOPMENT_TEAM = ABCDE12345

// Only when signing by hand (your own profile instead of the free account):
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Apple Development
// PROVISIONING_PROFILE_SPECIFIER = Profile name
