{
  // knip: unused files, exports and dependencies fail CI (CONTRIBUTING.md,
  // "No dead code"). Every exception below says why it is one.
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // pg_dump: a system binary (brew install postgresql@17) that
  // scripts/backup/extract.mjs spawns for the full backup; not an npm package.
  "ignoreBinaries": ["pg_dump"],
  "workspaces": {
    ".": {
      // Operational scripts, run by hand (`npm run sql`, `npx tsx …`).
      // (scripts/lint/*.ts is an entry through its npm script, lint:spanish.)
      "entry": ["scripts/**/*.{mjs,mts}", "e2e/support/servidor.mjs"],
      "project": ["scripts/**/*.{mjs,mts,ts}", "e2e/**/*.{ts,mjs}"],
      // The Playwright journeys (e2e/): the config and specs are found by the
      // playwright plugin through it.
      "playwright": { "config": ["e2e/playwright.config.ts"] },
      // Scripts run from the repo root and use the workspaces' hoisted
      // Prisma adapter on purpose: they operate on the same database as the
      // app, with the same version (ADR 0020). (`pg` is a root devDependency
      // since the journeys, which open their own test database with it.)
      "ignoreDependencies": ["@prisma/adapter-pg"],
    },
    "api": {
      // src/openapi/generate.ts: `npm run openapi` runs it from dist/.
      "entry": ["src/main.ts", "src/openapi/generate.ts", "test/**/*.e2e-spec.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // The driver under @prisma/adapter-pg, declared directly so production
      // installs pin it (it replaced Prisma's Rust engine, see b496c5a).
      // @prisma/client is the runtime of the generated client in
      // src/generated/prisma, which is gitignored and so invisible to knip
      // (ADR 0020).
      "ignoreDependencies": ["pg", "@types/pg", "@prisma/client"],
    },
    "frontend": {
      "project": ["src/**/*.{ts,tsx}"],
      // The client Orval writes from the whole v2 document (D11): it exports
      // every endpoint, used or not. What the web does not call yet is not dead code.
      "ignore": ["src/shared/api/generated/**"],
      // The component catalogue: its config and every story are entry points,
      // so a component used only by its story is not reported as dead code.
      "storybook": {
        "config": [".storybook/main.ts"],
        "entry": [".storybook/preview.tsx", "src/**/*.stories.tsx"],
      },
    },
    "packages/receipt-parser": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/flags": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
  },
}
