{
  // Only for `npm run typecheck`: reads @coco/receipt-parser from its SOURCE
  // so a clone with a stale or missing `dist` still checks (R5-A, A5). The
  // build (tsconfig.build.json) and the runtime keep resolving the package
  // through its `dist`, as production does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@coco/receipt-parser": ["../packages/receipt-parser/src/index.ts"]
    }
  }
}
