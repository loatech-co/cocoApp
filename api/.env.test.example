# ─────────────────────────────────────────────────────────────
# api/.env.test.example — the environment of the API e2e suite.
#
# `npm run test:e2e --workspace api` loads `api/.env.test` over everything
# else (test/setup-env.ts), and the suite EMPTIES the tables of this
# database. `bash scripts/setup-local-db.sh` copies this file and creates the
# database and both roles with these local-only passwords. CI writes the same
# variables in .github/workflows/ci.yml.
# ─────────────────────────────────────────────────────────────

NODE_ENV=test

# The API connects as coco_app, under row-level security, as in production
# (ADR 0019). The fixtures and the migrations go through the owner.
DATABASE_URL="postgresql://coco_app:local-only-coco-app-password@127.0.0.1:5432/coco_test"
DIRECT_URL="postgresql://coco_migrate:local-only-migrate-password@127.0.0.1:5432/coco_test"

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=silent
CHECK_BREACHED_PASSWORDS=false

# The suite signs this address up and expects it to be born admin.
BOOTSTRAP_ADMIN_EMAIL=admin-e2e@pruebas.coco

# Where the suite stores receipts. Relative to api/, ignored by git.
RECEIPTS_DIR=.soportes-test
