{
  "name": "@coco/api",
  "version": "0.1.0",
  "private": true,
  "description": "Coco App NestJS API. Compiled entry: dist/main.js (Hostinger Node.js Web App).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "openapi": "nest build && node dist/openapi/generate.js && prettier --write openapi.v2.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "NODE_ENV=test jest --config ./jest.coverage.config.js --runInBand --coverage",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:studio": "dotenv -e .env.migrate -- prisma studio",
    "prisma:migrate:dev": "dotenv -e .env.migrate -- prisma migrate dev",
    "prisma:migrate:status": "dotenv -e .env.migrate -- prisma migrate status",
    "prisma:migrate:reset": "dotenv -e .env.migrate -- prisma migrate reset",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:test:push": "dotenv -e .env.test -- prisma migrate deploy",
    "prebuild": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.1",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@coco/receipt-parser$": "<rootDir>/../../packages/receipt-parser/src/index.ts",
      "^@coco/flags$": "<rootDir>/../../packages/flags/src/index.ts"
    }
  }
}
