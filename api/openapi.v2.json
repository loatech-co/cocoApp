  "info": {
    "title": "Coco API",
    "description": "Contract v2, served under `/api/v2`: the v1 API in English and camelCase, with every\nlist paginated as `{ data, meta: { page, perPage, total } }`.\n\nEvery successful JSON response is wrapped as `{ data, meta }`. Every error is\n`{ error: { code, message, details } }`, where `details` lists the fields that failed.\nMessages meant for the user are in Spanish.\n\nIdentifiers are integers (int64) and money travels as a decimal string.",
    "version": "2",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorDetailResponse": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The input field at fault, when there is one."
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable kind: bad_request, unauthenticated, forbidden, not_found, conflict, duplicate, unprocessable, rate_limited, payload_too_large, unsupported_media_type, internal_error, unavailable…",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "description": "Human-readable, in Spanish: the client may show it as is."
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailResponse"
            }
          }
        },
        "required": ["code", "message", "details"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": ["error"]
      },
      "Split": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "categoryId": {
            "type": "number",
            "nullable": true
          },
          "amount": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "categoryId", "amount", "note"]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["expense", "income", "transfer"],
            "type": "string"
          },
          "transferDirection": {
            "nullable": true,
            "enum": ["out", "in"],
            "type": "string"
          },
          "status": {
            "enum": ["cleared", "pending"],
            "type": "string"
          },
          "source": {
            "enum": ["web", "ios_manual", "ios_photo", "wallet", "sms"],
            "type": "string"
          },
          "id": {
            "type": "number"
          },
          "uuid": {
            "type": "string"
          },
          "accountId": {
            "type": "number",
            "nullable": true
          },
          "date": {
            "type": "string",
            "description": "`YYYY-MM-DD`."
          },
          "period": {
            "type": "string",
            "description": "The month the transaction BELONGS to, as its first day (`YYYY-MM-DD`)."
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code of `amount`."
          },
          "categoryId": {
            "type": "number",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "merchant": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "transferGroupId": {
            "type": "string",
            "nullable": true
          },
          "externalRef": {
            "type": "string",
            "nullable": true,
            "description": "The client's own id for this capture; a second capture with it returns this one."
          },
          "rawText": {
            "type": "string",
            "nullable": true
          },
          "capturedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "needsReview": {
            "type": "boolean",
            "description": "Someone has to look at it: an unsure classification or a possible duplicate."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "splits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Split"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "type",
          "transferDirection",
          "status",
          "source",
          "id",
          "uuid",
          "accountId",
          "date",
          "period",
          "amount",
          "currency",
          "categoryId",
          "description",
          "merchant",
          "notes",
          "transferGroupId",
          "externalRef",
          "rawText",
          "capturedAt",
          "needsReview",
          "tags",
          "splits",
          "createdAt"
        ]
      },
      "PageMetaV2": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "description": "1-based page number."
          },
          "perPage": {
            "type": "number",
            "description": "Items per page, 1–200."
          },
          "total": {
            "type": "number",
            "description": "Items across every page."
          }
        },
        "required": ["page", "perPage", "total"]
      },
      "TransactionHistory": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "nullable": true
          },
          "last": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["first", "last"]
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "transferGroupId": {
            "type": "string"
          },
          "legs": {
            "description": "The two legs: out of one account, into the other.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          }
        },
        "required": ["transferGroupId", "legs"]
      },
      "CreateTransferInput": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "The month the transfer BELONGS to, as `YYYY-MM-DD` of its first day."
          },
          "fromAccountId": {
            "type": "number"
          },
