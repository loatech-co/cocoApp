# ─────────────────────────────────────────────────────────────
# api/.env.migrate.example — the LOCAL migration environment.
#
# Why a file of its own: the runtime role (coco_app) has no DDL on purpose, so
# it cannot run migrations. They run as `coco_migrate`, which owns the schema
# and, locally, has CREATEDB (Prisma's shadow database) and BYPASSRLS.
#
# `bash scripts/setup-local-db.sh` copies this to `api/.env.migrate` and
# creates the role with this password. It is a local-only password for a
# Postgres that listens on this machine; production never reads this file.
#
# Used by: npm run prisma:migrate:dev --workspace api, npm run seed:local,
# npm run sql (all load this file with dotenv-cli).
# ─────────────────────────────────────────────────────────────

# The schema owner, for migrations only.
DATABASE_URL="postgresql://coco_migrate:local-only-migrate-password@127.0.0.1:5432/coco_dev"

# The database `prisma migrate dev` diffs against on every migration.
SHADOW_DATABASE_URL="postgresql://coco_migrate:local-only-migrate-password@127.0.0.1:5432/coco_dev_shadow"

# Personal token of the Supabase CLI, read only by `npm run sql:supabase`.
# Empty: local development does not need it.
SUPABASE_ACCESS_TOKEN=
