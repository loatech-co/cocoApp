# ─────────────────────────────────────────────────────────────
# api/.env.migrate.example — plantilla SIN valores reales.
#
# Por qué existe este archivo aparte:
# el usuario de runtime (coco_app) NO tiene DDL a propósito, así que no puede
# correr migraciones. Las migraciones usan un usuario separado con privilegios
# de esquema, tal como exige el checklist de seguridad del PRD (6.1.2).
#
# Uso:  npm run prisma:migrate:dev
#       (los scripts inyectan este archivo con dotenv-cli)
#
# En Hostinger NO se usa `migrate dev` — solo `migrate deploy` a través de un
# túnel SSH (análisis 5.3 y 6), que no necesita shadow database.
# ─────────────────────────────────────────────────────────────

# Usuario con DDL, solo para migraciones
DATABASE_URL="mysql://coco_migrate:__CAMBIAR__@127.0.0.1:3306/coco_dev?connection_limit=5"

# Shadow database que `prisma migrate dev` crea y descarta en cada migración.
# El hosting compartido no permite crearla: por eso el desarrollo es local.
SHADOW_DATABASE_URL="mysql://coco_migrate:__CAMBIAR__@127.0.0.1:3306/coco_dev_shadow"
