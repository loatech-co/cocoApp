// ─────────────────────────────────────────────────────────────────────────────
// Coco App — the canonical mirror of the data model.
//
// Engine: PostgreSQL (Supabase), provider = "postgresql", reached through the
// `pg` driver adapter (see the generator below). The MariaDB of the first
// stage is gone: its migrations are kept, unread, in
// `prisma/archived-mysql-migrations`, and the history Prisma applies starts at
// `20260915000000_init_postgres`.
//
// Fixed rules:
//   · Physical names are snake_case plural through @@map / @map. They do not move.
//   · The client is English; where the database kept a Spanish name, @map and
//     @@map pair the two, and this file is the one place that does (ADR 0026).
//   · Money is ALWAYS Decimal @db.Decimal(15,2). Never Float. In TypeScript it
//     is handled with Prisma.Decimal (.plus/.minus/.times), never with `number`:
//     a JS `number` is IEEE-754 and piles up rounding error.
//   · Business dates: DateTime @db.Date (a transaction happens on "a day").
//     Timestamps: DateTime @db.Timestamp(3) in UTC, shown in America/Bogota.
//   · Every top-level entity carries user_id. No query crosses users.
//   · An explicit onDelete on every relation, chosen by business meaning.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  // Prisma 7: the `prisma-client` generator writes the client in TypeScript
  // into `src/generated/prisma` (not node_modules), so `nest build` compiles
  // it with the rest and it travels inside `dist/`. `cjs` because the Nest API
  // is CommonJS (ADR 0020).
  //
  // No Rust engine: Prisma talks to Postgres through the `pg` adapter. It is
  // not an optimization: the Rust engine panicked with
  // "PANIC: timer has gone away" every time the platform suspended the
  // process for inactivity, took the process down with it and left the site
  // on 503 until a restart. Without the Rust engine there is no timer thread
  // left to die.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// The URLs live in `api/prisma.config.ts` since Prisma 7.
datasource db {
  provider = "postgresql"
}

// ── Enums (mirror of the ENUM columns) ───────────────────────────────────────

enum AccountType {
  cash
  debit
  credit
  bank
  savings
  other
}

enum CategoryKind {
  expense
  income
  transfer
}

enum TransactionType {
  expense
  income
  transfer
}

/// Where a transaction came in from.
///
/// Until now everything came in through the web and there was no need to say
/// so. With the phone app there are four more ways in, and knowing which is
/// not curiosity: it decides whether to look for a duplicate —an Apple Pay
/// payment produces the Wallet transaction AND the bank's SMS— and it lets us
/// read later which way gets it right and which one sends things to review.
enum TransactionSource {
  web
  ios_manual
  ios_photo
  wallet
  sms
}

enum TransactionStatus {
  cleared
  pending
}

/// Tells apart the two legs of a transfer.
///
/// Added in Phase 1 on top of the canonical schema: both legs share
/// `transfer_group_id`, are both `type='transfer'` and store a positive
/// `amount`, so without this column it is IMPOSSIBLE to know which account the
/// money left and which it entered — and the derived balance depends on
/// exactly that. The API contract already returned `direction: "out" | "in"`
/// on the legs, so this materializes what the contract already promised.
///
/// NULL on every transaction that is not a transfer.
enum TransferDirection {
  out
  in
}

/// The account's role. Only `admin` sees the admin panel.
enum UserRole {
  admin
  user
}

/// The account's life cycle.
///
/// `pending` is where every sign-up starts: the account exists but CANNOT get
/// in until an admin approves it. It is what keeps anyone with the link out of
/// a finance app.
enum UserStatus {
  pending
  active
  suspended
}

/// Life cycle of an import batch (M4).
///
/// `draft` is the state it is reviewed in: the rows exist but there is not a
/// single transaction in `transactions` yet. Nothing enters the user's
/// finances without their confirmation.
enum ImportStatus {
  draft
  committed
  discarded
}

/// What was decided about each row read from the document.
///
/// `duplicate` is a SUSPICION, not a verdict: two $5,000 coffees on the same
/// day at the same place are two real transactions. The system points it out
/// and the person decides — inform, do not block.
enum ImportRowStatus {
  pending
  accepted
  duplicate
  skipped
}

/// Where the parsed text came from.
///
/// Kept so a bad parse can be debugged without keeping the document: if twenty
/// `pdf` rows come out crooked and the `image` ones do not, the problem is in
/// the PDF extractor.
enum ImportSource {
  image
  pdf
  /// A CSV prepared by the person.
  ///
  /// It is the EXACT way in: there is no text recognition that can get it
  /// wrong, so it is the right one to migrate years of history in one go.
  /// Kept apart from `pdf` and `image` so we can compare later which way
  /// needs fewer corrections in review.
  csv
  manual
}

// ── users ────────────────────────────────────────────────────────────────────
// The root of all scoping and, from now on, the identity authority too:
// authentication is our own, not delegated.

model User {
  id          BigInt     @id @default(autoincrement())
  uuid        String     @unique(map: "uq_users_uuid") @default(uuid()) @db.Char(36)
  email       String     @unique(map: "uq_users_email") @db.VarChar(255)
  /// Link to Supabase's `auth.users`, which is where the credentials live.
  /// There is no password or hash here: this table is the person's PROFILE
  /// —role, status, who approved them—, not their credential.
  ///
  /// Optional only because of the transition: a row without `auth_id` predates
  /// the move to Supabase Auth and cannot sign in until its matching account
  /// is created.
  authId      String?    @unique(map: "uq_users_auth_id") @map("auth_id") @db.Uuid
  displayName String?    @map("display_name") @db.VarChar(255)
  role        UserRole   @default(user)
  status      UserStatus @default(pending)

  /// Immediate session revocation. Every access token issued BEFORE this mark
  /// is rejected, without going to the network: the guard already reads this
  /// row on every request. Changing the password, suspending the account or
  /// "signing out on every device" simply move this value forward.
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from") @db.Timestamp(3)

  /// The brute-force defense moved to Supabase with the migration: sign-in no
  /// longer goes through this code, so counting failures here would protect
  /// nothing. Only the last sign-in is kept, which is profile data.
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp(3)

  /// Trace of who approved the account and when.
  approvedAt   DateTime? @map("approved_at") @db.Timestamp(3)
  approvedById BigInt?   @map("approved_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  approvedBy    User?            @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, map: "fk_users_approved_by")
  approvedUsers User[]           @relation("ApprovedBy")
  auditEvents   AuditLog[]
  accounts      Account[]
  categories    Category[]
  tags          Tag[]
  transactions  Transaction[]
  preferences   UserPreference[]
  importBatches ImportBatch[]
  categoryRules CategoryRule[]
  receipts      Receipt[]

  @@index([status], map: "idx_users_status")
  @@map("users")
}

// ── Sessions ─────────────────────────────────────────────────────────────────
// There was a `refresh_tokens` table here, with rotation and reuse detection.
// Issuing and rotating tokens moved to Supabase Auth with the migration, so
// the table was dropped: keeping two session stores side by side would be
// guaranteeing they drift apart.
//
// What was NOT delegated is immediate revocation: `users.sessions_valid_from`
// is still ours, and the guard compares it with the `iat` of the Supabase
// token on every request. Suspending an account or closing every session takes
// effect at once, without waiting for anything to expire or depending on
// Supabase answering.

// ── audit_log (T4) ───────────────────────────────────────────────────────────
// Insert-only log. Brought forward to Phase 1 instead of waiting for Phase 5:
// in a finance app, being able to rebuild what happened and when is not an
// extra.
//
// `user_id` is nullable —unlike the canonical schema— because a sign-in
// attempt against an email that does not exist must be logged too, and there
// is no user to attribute it to.

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt?  @map("user_id")
  entity      String   @db.VarChar(64)
  entityId    BigInt?  @map("entity_id")
  action      String   @db.VarChar(64)
  changesJson Json?    @map("changes_json")
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_audit_user")

  @@index([userId, createdAt], map: "idx_audit_user_created")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([action, createdAt], map: "idx_audit_action_created")
  @@map("audit_log")
}

// ── accounts ─────────────────────────────────────────────────────────────────
// Means of payment. The balance is NOT stored: it is derived from
// opening_balance plus the signed sum of the transactions. Accounts with
// history are archived (is_archived), never deleted.

model Account {
  id             BigInt      @id @default(autoincrement())
  userId         BigInt      @map("user_id")
  name           String      @db.VarChar(255)
  type           AccountType @default(other)
  currency       String      @default("COP") @db.Char(3)
  institution    String?     @db.VarChar(255)
  last4          String?     @db.Char(4)
  creditLimit    Decimal?    @map("credit_limit") @db.Decimal(15, 2)
  cutoffDay      Int?        @map("cutoff_day") @db.SmallInt
  paymentDay     Int?        @map("payment_day") @db.SmallInt
  openingBalance Decimal     @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  isArchived     Boolean     @default(false) @map("is_archived")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamp(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_accounts_user")
  transactions  Transaction[]
  importBatches ImportBatch[]

  @@index([userId, isArchived], map: "idx_accounts_user_archived")
  @@map("accounts")
}

// ── categories ───────────────────────────────────────────────────────────────
// The user's editable taxonomy, one level of hierarchy (up to two) through
// parent_id. They are archived, not deleted. If one were deleted anyway, its
// transactions survive WITHOUT a category (SetNull) — in line with not being
// rigid.

/// How often a recurring payment comes back. The database keeps the type's
/// name and its Spanish values (`mensual`…); the client speaks these.
enum Periodicity {
  monthly    @map("mensual")
  bimonthly  @map("bimestral")
  quarterly  @map("trimestral")
  semiannual @map("semestral")
  annual     @map("anual")

  @@map("Periodicidad")
}

/// ── Receipts ─────────────────────────────────────────────────────────────
/// A transaction's receipt: the PDF or the photo that proves the payment
/// happened. The table is still `soportes`.
///
/// ── Why a table and not a column ────────────────────────────────────────
/// Because one payment can come with several papers —the Claro bill arrives
/// split in three— and a column would force us to invent a separator, keep
/// it up and give up ordering them.
///
/// ── Why the file is NOT here ────────────────────────────────────────────
/// The table holds the RECORD; the binary lives in a private store outside
/// the web tree. Keeping megabytes in the database bloats every backup, every
/// query and every restore, and buys nothing: an endpoint that checks the
/// session before handing it over is needed anyway.
model Receipt {
  id            BigInt   @id @default(autoincrement())
  uuid          String   @unique(map: "uq_soportes_uuid") @default(uuid()) @db.Char(36)
  /// DENORMALIZED from the transaction, on purpose.
  ///
  /// Access control is a `where` on this column, without going through a
  /// join. One day someone writes a query that forgets the join and hands out
  /// someone else's receipt; with the owner here, the query that forgets
  /// returns nothing instead of returning too much.
  userId        BigInt   @map("user_id")
  transactionId BigInt   @map("transaction_id")
  /// 1..N. It is the "1 of 3" of the file name: the order they are looked at in.
  position      Int      @default(1) @map("orden")
  /// The name it arrived with. Only for showing it and for downloading it with
  /// a name that means something; NEVER used to build a path.
  fileName      String   @map("nombre_archivo") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  /// The RELATIVE path inside the private store, written by the server:
  /// `<userId>/<uuid>.<ext>`. Opaque on purpose —it carries nothing that comes
  /// from the original name— so there is no way to step out of the store.
  storageKey    String   @unique(map: "uq_soportes_storage_key") @map("storage_key") @db.VarChar(500)
  sizeBytes     Int      @map("tamano")
  /// sha256 of the CONTENT. It is what makes the import idempotent: the same
  /// file twice is the same receipt, even if its name changes.
  contentHash   String   @map("huella") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_soportes_user")
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, map: "fk_soportes_transaction")

  @@unique([transactionId, contentHash], map: "uq_soportes_tx_huella")
  @@index([transactionId, position], map: "idx_soportes_tx_orden")
  @@index([userId], map: "idx_soportes_user")
  @@map("soportes")
}

model Category {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt       @map("user_id")
  name       String       @db.VarChar(255)
  parentId   BigInt?      @map("parent_id")
  kind       CategoryKind @default(expense)
  color      String?      @db.Char(7)
  icon       String?      @db.VarChar(64)
  sortOrder  Int          @default(0) @map("sort_order")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(3)

  /// ── Recurrence ────────────────────────────────────────────────────────
  /// It lives on the CATEGORY and not on the transaction because what repeats
  /// is the concept —"the rent"— and not one month's payment. Put on each
  /// transaction it would have to be repeated twelve times a year and the
  /// copies kept in agreement; and when looking at an unpaid month there
  /// would be no transaction to read it from, which is exactly when we need
  /// to know something is missing.
  isRecurring  Boolean      @default(false) @map("recurrente")
  periodicity  Periodicity? @map("periodicidad")
  /// Day of the month it is due. 1–31, and short months are clipped to their
  /// last day: a 31st in February is the 28th.
  paymentDay   Int?         @map("dia_de_pago") @db.SmallInt
  /// The cycle's reference month, 1–12. Only when the periodicity is NOT
  /// monthly: a quarterly payment does not just fall "every three months", it
  /// falls in March, June, September and December, or in January, April,
  /// July and October, depending on where it starts. Without this,
  /// "every three months" does not say which.
  paymentMonth Int?         @map("mes_de_pago") @db.SmallInt

  /// ── Budget ────────────────────────────────────────────────────────────
  /// What this concept is expected to cost each time it is due. When set, it
  /// wins: the month's forecast is this number and not the average of what
  /// it cost before.
  ///
  /// It exists because some expenses have a value that is KNOWN, not
  /// estimated —rent under contract, a school fee, a fixed instalment— and
  /// averaging the three previous months gave them a worse figure than the
  /// data: the month paid with a surcharge pulled it up, the one paid in part
  /// pulled it down.
  ///
  /// Empty, it keeps being averaged, which is right for what really varies:
  /// electricity, groceries, fuel.
  ///
  /// It only means something on a recurring CONCEPT. A cost center and a
  /// category are sums of what hangs from them, and a concept that does not
  /// come back has no "each time".
  budget Decimal? @map("presupuesto") @db.Decimal(15, 2)

  /// ── Auto-paid ─────────────────────────────────────────────────────────
  /// The concept does not wait for someone to record it: when its due day
  /// comes, the transaction creates itself and stops being pending.
  ///
  /// For what is charged without anyone doing anything —a direct debit, a
  /// subscription, a standing order—. Without it, someone had to go and mark
  /// it every month, which is clerk's work for money that already left.
  ///
  /// Only from the month it is switched on, going forward: it never fills in
  /// past months. An old month without a transaction is data —it was not paid,
  /// or not recorded— and making it up backwards would change figures someone
  /// already took as good.
  ///
  /// It only means something on a recurring CONCEPT.
  isAutoPaid Boolean @default(false) @map("pago_automatico")

  /// ── Paid in several payments ──────────────────────────────────────────
  /// The concept is not settled by one payment: it gets covered bit by bit.
  /// Groceries take four trips, fuel six fill-ups, and none of those trips
  /// ends the month.
  ///
  /// Without it, the first transaction took the concept off pending payments,
  /// and for the rest of the month the list said groceries were done with
  /// 320,000 out of a 1,200,000 budget. The missing figure was not wrong
  /// anywhere —the donut and the totals had it—, but the only screen that
  /// answers "what do I still have to pay?" answered that nothing.
  ///
  /// When marked, the concept stays on the list while what was paid is LESS
  /// than what was expected, showing how much it is at. It leaves when it
  /// reaches or passes it, which is when it really stopped being missing.
  ///
  /// ── It cannot be combined with auto-paid ──────────────────────────────
  /// And not because of a technical limit: the two flags say opposite things
  /// about the same concept. Auto-paid says "this is charged on its own, in
  /// full, on its due day"; this one says "this is covered in pieces and
  /// nobody knows how many". Both on, the automatic charge would write the
  /// full amount on the due day and the concept would leave the list without
  /// anyone having gone shopping.
  ///
  /// It only means something on a recurring CONCEPT, and only when there is
  /// an expected figure: without a total to reach, "what is missing" does not
  /// exist.
  isMultiPayment Boolean @default(false) @map("varios_pagos")

  /// ── Static ────────────────────────────────────────────────────────────
  /// What hangs from a STATIC cost center is not reclassified: neither from
  /// the transactions table nor from a transaction's modal. It is for the
  /// structure that is not improvised —the rent does not change group on a
  /// Tuesday— and so that a distracted click in a hundred-row table does not
  /// move money around without anyone noticing. The way out is making the
  /// center dynamic in Cost centers.
  ///
  /// It is only read from the CENTER, the top level: a category or a concept
  /// inherits what theirs says.
  isStatic Boolean @default(false) @map("estatico")

  /// ── Keywords ──────────────────────────────────────────────────────────
  /// What has to be found in a receipt to know it belongs to this concept: the
  /// creditor's business name, its tax id, the name it shows on the bill. They
  /// are searched for in the text that comes out of the receipt —the PDF's
  /// embedded text or the OCR's— and in the file name too.
  ///
  /// It lives on the CATEGORY and not in a table of its own because it is
  /// written and deleted together with the concept, never on its own: it is
  /// the concept's data, like its icon or its periodicity. A table would need
  /// its own life cycle —create, list, delete orphans on merging— to keep
  /// three words.
  ///
  /// They are stored AS THEY WERE TYPED. Dropping accents and lowercasing is
  /// the comparison's job, and doing it on save would turn «Aquaoccidente»
  /// into «aquaoccidente» on the screen of whoever typed it.
  keywords String[] @default([]) @map("palabras_clave")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_categories_user")
  parent       Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, map: "fk_categories_parent")
  children     Category[]         @relation("CategoryTree")
  transactions Transaction[]
  importRows   ImportRow[]
  rules        CategoryRule[]
  splits       TransactionSplit[]

  @@index([userId, kind, parentId], map: "idx_categories_user_kind_parent")
  @@map("categories")
}

// ── tags ─────────────────────────────────────────────────────────────────────
// Free, cross-cutting labels ("reimbursable", "cartagena-trip"). Unlike
// categories —the vertical, single taxonomy— a tag cuts across any category,
// account or type, and a transaction can carry several.
//
// The unique (user_id, name) allows an idempotent "get-or-create": the UI
// creates them on the fly while the user types, without asking.

model Tag {
  id     BigInt  @id @default(autoincrement())
  userId BigInt  @map("user_id")
  name   String  @db.VarChar(255)
  color  String? @db.Char(7)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tags_user")
  transactions TransactionTag[]

  @@unique([userId, name], map: "uq_tags_user_name")
  @@map("tags")
}

// ── transactions ─────────────────────────────────────────────────────────────
// THE CORE. Everything else is derived from here.
// `amount` is ALWAYS stored positive; the economic sign comes from `type`.
// `category_id` is nullable on purpose: a transaction can exist without a
// category and that never blocks saving it.
//
// account_id is Restrict (an account with transactions is not deleted: it is
// archived). category_id is SetNull (optional enrichment that does not destroy
// the transaction).
//
// recurring_concept_id and import_batch_id arrive in their phases (3 and 2);
// they are added as new migrations, never by rewriting one already applied.

model Transaction {
  id              BigInt             @id @default(autoincrement())
  uuid            String             @unique(map: "uq_transactions_uuid") @default(uuid()) @db.Char(36)
  userId          BigInt             @map("user_id")
  /// OPTIONAL on purpose.
  ///
  /// Keeping accounts —cards, savings, cash— is a feature switched on in the
  /// settings, not a requirement for recording an expense. Whoever only wants
  /// to know how much they spent this month should not have to make up an
  /// account first.
  ///
  /// The consequence has to be faced head on: a transaction without an
  /// account takes part in no balance. Balances stay exact for the accounts
  /// that exist, and there is simply no balance for the rest.
  accountId       BigInt?            @map("account_id")
  date            DateTime           @db.Date
  /// The MONTH THE EXPENSE BELONGS TO, which is not always the one of `date`.
  ///
  /// March's bill is paid on April 6th: `date` stores April 6th —it is when
  /// the money left, and balances depend on that— and `period` stores March,
  /// which is the month one means when asking "how much did I spend in
  /// March?".
  ///
  /// Stored as DAY 1 of the month. It is a date and not a "2026-03" string so
  /// it can be sorted, filtered by range and grouped with the same tools as
  /// `date`.
  ///
  /// When unknown, it is the month of `date`: most expenses are paid in their
  /// own month and making people declare it would be friction for nothing.
  period          DateTime           @db.Date
  amount          Decimal            @db.Decimal(15, 2)
  /// ISO 4217. Everything is COP today; the column exists so that formatting
  /// reads the currency of the row instead of assuming it (phase 6.4).
  currency        String             @default("COP") @db.Char(3)
  type            TransactionType    @default(expense)
  categoryId      BigInt?            @map("category_id")
  description     String?            @db.VarChar(255)
  merchant        String?            @db.VarChar(255)
  notes           String?            @db.Text
  transferGroupId String?            @map("transfer_group_id") @db.Char(36)
  transferDir     TransferDirection? @map("transfer_direction")
  /// The transaction's fingerprint when it came from an import. Used to spot
  /// repeats in future imports. It has NO UNIQUE on purpose: two $5,000
  /// coffees on the same day at the same place are two real transactions, and
  /// a constraint would reject the second. It informs, it does not block.
  externalRef     String?            @map("external_ref") @db.VarChar(255)
  /// Which import it came from, if any. It is what lets a whole batch be
  /// undone without deleting forty transactions by hand.
  importBatchId   BigInt?            @map("import_batch_id")
  status          TransactionStatus  @default(cleared)

  /// ── Capture ────────────────────────────────────────────────────────────
  /// `web` by default for everything that already exists: it is where it came in.
  source      TransactionSource @default(web)
  /// The text the expense came from —the receipt's OCR, the bank's SMS—.
  /// Until now it was thrown away, and with it went the only way of knowing
  /// why it was classified the way it was, and of reinterpreting it when the
  /// engine learns something new.
  rawText     String?           @map("raw_text") @db.Text
  /// When it was captured, with time zone. Different from `date` —the day of
  /// the expense— and from `created_at` —when it reached the server—: a
  /// capture queued offline is created hours after it was taken.
  capturedAt  DateTime?         @map("captured_at") @db.Timestamptz(3)
  /// What the system could not classify with certainty, or what might be a
  /// duplicate. It never guesses: it flags it and leaves it to someone.
  needsReview Boolean           @default(false) @map("por_revisar")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tx_user")
  account  Account?           @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_tx_account")
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_tx_category")
  splits   TransactionSplit[]
  tags     TransactionTag[]
  receipts Receipt[]

  /// SetNull and not Cascade: deleting an import's record cannot take with it
  /// transactions the person already took as good.
  importBatch        ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull, map: "fk_tx_import_batch")
  possibleDuplicates ImportRow[]  @relation("PossibleDuplicate")

  /// UNIQUE, not just indexed. `external_ref` is the fingerprint two paths use
  /// to avoid duplicating: the history importer and auto-pay, which writes
  /// `auto:<concept>:<month>`. Both check before inserting, and both can lose
  /// that race against another simultaneous request —two open tabs are
  /// enough—. Here it is not lost.
  @@unique([userId, externalRef], map: "uq_tx_user_external_ref")
  @@index([userId, importBatchId], map: "idx_tx_user_import_batch")
  @@index([userId, date], map: "idx_tx_user_date")
  @@index([userId, period], map: "idx_tx_user_period")
  @@index([userId, categoryId], map: "idx_tx_user_category")
  @@index([accountId, date], map: "idx_tx_account_date")
  @@index([transferGroupId], map: "idx_tx_transfer_group")
  @@map("transactions")
}

// ── transaction_splits ───────────────────────────────────────────────────────
// Splits a transaction across several categories (a supermarket purchase that
// is 70% groceries and 30% cleaning).
//
// INVARIANT THAT CANNOT BREAK: the splits must add up to EXACTLY the
// transaction's `amount`. A row-level CHECK cannot see the other rows, so the
// service checks the sum with Prisma.Decimal inside the $transaction, before
// committing. If it does not add up: 422 and ROLLBACK.
//
// When a transaction has splits, the per-category aggregation uses the
// splits, not the header's category_id.

model TransactionSplit {
  id            BigInt  @id @default(autoincrement())
  transactionId BigInt  @map("transaction_id")
  categoryId    BigInt? @map("category_id")
  amount        Decimal @db.Decimal(15, 2)
  note          String? @db.VarChar(255)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, map: "fk_splits_tx")
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_splits_category")

  @@index([transactionId], map: "idx_splits_transaction")
  @@map("transaction_splits")
}

// ── transaction_tags ─────────────────────────────────────────────────────────
// N:M bridge between transactions and tags. The composite PK prevents
// duplicates and doubles as the index. CASCADE on both sides: when the
// transaction or the tag is deleted, the link goes away on its own.

model TransactionTag {
  transactionId BigInt @map("transaction_id")
  tagId         BigInt @map("tag_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, map: "fk_tt_tx")
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "fk_tt_tag")

  @@id([transactionId, tagId])
  @@index([tagId], map: "idx_tt_tag")
  @@map("transaction_tags")
}

// ── import_batches (M4) ──────────────────────────────────────────────────────
// One document read: a screenshot, a statement PDF, a pasted text.
//
// WHAT IS NOT KEPT HERE, on purpose: not the image, not the PDF, not the raw
// OCR text. The whole point of doing OCR in the browser is that the statement
// NEVER leaves the user's device (analysis 5.6); uploading it to the server
// would destroy exactly that. What is kept are the rows already parsed, which
// is what the person is going to review.
//
// The batch outlives the commit because it is what allows UNDOING: without
// it, a badly parsed import can only be fixed by deleting forty transactions
// by hand.

model ImportBatch {
  id          BigInt       @id @default(autoincrement())
  uuid        String       @unique(map: "uq_import_batches_uuid") @default(uuid()) @db.Char(36)
  userId      BigInt       @map("user_id")
  /// Optional, for the same reason as in transactions: a statement can be
  /// imported without saying which account it belongs to.
  accountId   BigInt?      @map("account_id")
  source      ImportSource @default(image)
  status      ImportStatus @default(draft)
  /// The file name, only so the person recognizes the batch. Never its content.
  label       String?      @db.VarChar(255)
  /// Which OcrProvider implementation produced it. Used to compare quality
  /// the day a server-side alternative exists.
  ocrProvider String?      @map("ocr_provider") @db.VarChar(64)
  committedAt DateTime?    @map("committed_at") @db.Timestamp(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_import_batch_user")
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_import_batch_account")
  rows         ImportRow[]
  transactions Transaction[]

  @@index([userId, status], map: "idx_import_batch_user_status")
  @@map("import_batches")
}

// ── import_rows (M4) ─────────────────────────────────────────────────────────
// A candidate line from the document. It lives in `draft` while it is
// reviewed and does not touch the user's finances until the batch is
// confirmed.
//
// `amount` is Decimal like any other money in the app: parsing to `number`
// here and converting later would already have lost cents.

model ImportRow {
  id            BigInt          @id @default(autoincrement())
  batchId       BigInt          @map("batch_id")
  /// Order in the document. Reviewing out of order is disorienting.
  position      Int
  date          DateTime        @db.Date
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType @default(expense)
  description   String?         @db.VarChar(255)
  status        ImportRowStatus @default(pending)
  /// Category suggested by T1. It is a SUGGESTION: the person changes it or
  /// removes it.
  categoryId    BigInt?         @map("category_id")
  /// 0–100. Shown so it is clear how much to trust the suggestion.
  confidence    Int?            @db.SmallInt
  /// Deterministic fingerprint to spot repeats. See `fingerprint.ts`.
  fingerprint   String          @db.Char(64)
  /// If a repeat is suspected, which existing transaction it looks like.
  duplicateOfId BigInt?         @map("duplicate_of_id")

  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade, map: "fk_import_row_batch")
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_import_row_category")
  duplicateOf Transaction? @relation("PossibleDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull, map: "fk_import_row_duplicate")

  @@index([batchId, position], map: "idx_import_row_batch_position")
  @@map("import_rows")
}

// ── category_rules (T1) ──────────────────────────────────────────────────────
// Automatic categorization rules: "if the description contains X, suggest
// category Y".
//
// They are SUGGESTIONS. The product's no-rigidity principle rules: the system
// informs, never blocks, and a transaction without a category can always be
// saved.
//
// Besides these explicit rules, the service learns from the user's own
// history, which is the strongest signal and needs no lists to maintain.

model CategoryRule {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  /// Fragment to look for in the description, already lowercase and without
  /// accents.
  pattern    String   @db.VarChar(120)
  categoryId BigInt   @map("category_id")
  /// Higher priority wins when several rules match. The ones the person
  /// creates weigh more than the ones seeded by default.
  priority   Int      @default(0)
  /// How many times it got it right. Goes up when the suggestion is accepted.
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_rule_user")
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "fk_rule_category")

  @@unique([userId, pattern], map: "uq_rule_user_pattern")
  @@index([userId, priority], map: "idx_rule_user_priority")
  @@map("category_rules")
}

// ── user_preferences (T5) ────────────────────────────────────────────────────
// Per-user key-value store. pref_value is JSON so it can hold arbitrary
// structures without migrating the schema. The unique (user_id, pref_key)
// allows an idempotent upsert.
//
// `Json` is `jsonb` in Postgres.

model UserPreference {
  id        BigInt @id @default(autoincrement())
  userId    BigInt @map("user_id")
  prefKey   String @map("pref_key") @db.VarChar(64)
  prefValue Json   @map("pref_value")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_pref_user")

  @@unique([userId, prefKey], map: "uq_pref_user_key")
  @@map("user_preferences")
}
