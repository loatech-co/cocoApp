// ─────────────────────────────────────────────────────────────────────────────
// Coco App — espejo canónico del modelo de datos.
//
// Motor: MariaDB (Hostinger). Prisma la trata con provider = "mysql": el código
// no sabe ni le importa si detrás hay MySQL o MariaDB, y por eso la etapa 2 es
// un cambio de DATABASE_URL, no una reescritura (análisis 5.1).
//
// Se usa el CONECTOR ESTÁNDAR, nunca el driver adapter @prisma/adapter-mariadb:
// tiene un bug conocido con columnas JSON, y aquí se usa JSON en
// user_preferences.pref_value y (más adelante) audit_log.changes_json.
//
// Reglas inamovibles:
//   · Nombres físicos snake_case plural vía @@map / @map. Son inamovibles.
//   · Dinero SIEMPRE Decimal @db.Decimal(15,2). Jamás Float. En TypeScript se
//     opera con Prisma.Decimal (.plus/.minus/.times), nunca con `number`:
//     `number` en JS es IEEE-754 y acumula error de redondeo.
//   · Fechas de negocio: DateTime @db.Date (un movimiento ocurre "un día").
//     Timestamps: DateTime @db.Timestamp(3) en UTC, mostrados en America/Bogota.
//   · Toda entidad de primer nivel lleva user_id. Ninguna consulta cruza usuarios.
//   · onDelete explícito en cada relación, elegido por semántica de negocio.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums (espejo de las columnas ENUM) ──────────────────────────────────────

enum AccountType {
  cash
  debit
  credit
  bank
  savings
  other
}

enum CategoryKind {
  expense
  income
  transfer
}

enum TransactionType {
  expense
  income
  transfer
}

enum TransactionStatus {
  cleared
  pending
}

/// Distingue las dos patas de una transferencia.
///
/// Añadido en Fase 1 sobre el esquema canónico: las dos patas comparten
/// `transfer_group_id`, son ambas `type='transfer'` y guardan `amount` positivo,
/// así que sin esta columna es IMPOSIBLE saber de qué cuenta salió el dinero y
/// a cuál entró — y el saldo derivado depende justamente de eso. El contrato de
/// la API ya devolvía `direction: "out" | "in"` en las patas, así que esto es
/// materializar lo que el contrato ya prometía.
///
/// Es NULL en todo movimiento que no sea transferencia.
enum TransferDirection {
  out
  in
}

/// Rol de la cuenta. Solo `admin` ve el panel de administración.
enum UserRole {
  admin
  user
}

/// Ciclo de vida de la cuenta.
///
/// `pending` es el estado inicial de todo registro: la cuenta existe pero NO
/// puede entrar hasta que un admin la apruebe. Es lo que evita que cualquiera
/// con el enlace se meta a una app de finanzas.
enum UserStatus {
  pending
  active
  suspended
}

/// Ciclo de vida de un lote de importación (M4).
///
/// `draft` es el estado en el que se revisa: las filas existen pero todavía no
/// hay ni un movimiento en `transactions`. Nada entra a las finanzas del
/// usuario sin que confirme.
enum ImportStatus {
  draft
  committed
  discarded
}

/// Qué se decidió sobre cada fila leída del documento.
///
/// `duplicate` es una SOSPECHA, no un veredicto: dos cafés de $5.000 el mismo
/// día en el mismo sitio son dos movimientos reales. El sistema lo señala y la
/// persona decide — informar, no bloquear.
enum ImportRowStatus {
  pending
  accepted
  duplicate
  skipped
}

/// De dónde salió el texto que se parseó.
///
/// Se guarda para poder depurar un parseo malo sin conservar el documento: si
/// veinte filas de `pdf` salen torcidas y las de `image` no, el problema está
/// en el extractor de PDF.
enum ImportSource {
  image
  pdf
  /// Un CSV preparado por la persona.
  ///
  /// Es la vía EXACTA: no hay reconocimiento de texto que pueda equivocarse,
  /// así que es lo indicado para migrar años de historial de una sola vez.
  /// Se guarda aparte de `pdf` e `image` para poder comparar después qué vía
  /// produce menos correcciones en la revisión.
  csv
  manual
}

// ── users ────────────────────────────────────────────────────────────────────
// Raíz de todo el scoping y, desde ahora, también la autoridad de identidad:
// la autenticación es propia, no delegada.

model User {
  id           BigInt     @id @default(autoincrement())
  uuid         String     @unique(map: "uq_users_uuid") @default(uuid()) @db.Char(36)
  email        String     @unique(map: "uq_users_email") @db.VarChar(255)
  /// Hash argon2id. La contraseña en claro no existe en ningún lado: ni en la
  /// base, ni en los logs, ni en memoria más allá del tiempo de verificar.
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String?    @map("display_name") @db.VarChar(255)
  role         UserRole   @default(user)
  status       UserStatus @default(pending)

  /// Revocación inmediata de sesiones. Todo access token emitido ANTES de esta
  /// marca se rechaza, sin salir a la red: el guard ya lee esta fila en cada
  /// petición. Cambiar la contraseña, suspender la cuenta o "cerrar sesión en
  /// todos los dispositivos" simplemente adelantan este valor.
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from") @db.Timestamp(3)

  /// Defensa contra fuerza bruta. Se usa retraso progresivo, no bloqueo duro:
  /// un bloqueo duro permitiría que alguien deje a otro fuera de su cuenta a
  /// propósito con solo fallar el login varias veces.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamp(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamp(3)

  /// Traza de quién aprobó la cuenta y cuándo.
  approvedAt   DateTime? @map("approved_at") @db.Timestamp(3)
  approvedById BigInt?   @map("approved_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  approvedBy    User?            @relation("AprobadoPor", fields: [approvedById], references: [id], onDelete: SetNull, map: "fk_users_approved_by")
  aprobados     User[]           @relation("AprobadoPor")
  refreshTokens RefreshToken[]
  auditEvents   AuditLog[]
  accounts      Account[]
  categories    Category[]
  tags          Tag[]
  transactions  Transaction[]
  preferences   UserPreference[]
  importBatches ImportBatch[]
  categoryRules CategoryRule[]

  @@index([status], map: "idx_users_status")
  @@map("users")
}

// ── refresh_tokens ───────────────────────────────────────────────────────────
// Sesiones de larga vida.
//
// El token NUNCA se guarda: solo su SHA-256. Un volcado de esta tabla no le
// sirve a nadie para entrar. SHA-256 basta —y argon2 sería un desperdicio de
// CPU— porque el token es aleatorio de 256 bits: no hay diccionario que
// atacar, a diferencia de una contraseña elegida por una persona.
//
// ROTACIÓN CON DETECCIÓN DE REUSO: cada refresh consume el token y emite uno
// nuevo de la misma `family_id`. Si alguna vez se presenta un token ya usado,
// significa que alguien tiene una copia robada, y se revoca la familia entera.
// Es el patrón que recomienda la OAuth 2.0 Security BCP para clientes públicos.

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique(map: "uq_refresh_token_hash") @map("token_hash") @db.Char(64)
  /// Agrupa la cadena de rotaciones que nació de un mismo login.
  familyId  String    @map("family_id") @db.Char(36)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  /// Marca el momento en que se rotó. Un token con `used_at` que vuelve a
  /// aparecer es la señal de robo.
  usedAt    DateTime? @map("used_at") @db.Timestamp(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_refresh_user")

  @@index([userId, revokedAt], map: "idx_refresh_user_revoked")
  @@index([familyId], map: "idx_refresh_family")
  @@index([expiresAt], map: "idx_refresh_expires")
  @@map("refresh_tokens")
}

// ── audit_log (T4) ───────────────────────────────────────────────────────────
// Bitácora de solo-inserción. Se adelanta a la Fase 1 en vez de esperar a la 5:
// en una app de finanzas, poder reconstruir qué pasó y cuándo no es un extra.
//
// `user_id` es NULL-able —a diferencia del esquema canónico— porque un intento
// de login contra un correo inexistente también debe quedar registrado, y ahí
// no hay usuario al que atribuirlo.

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt?  @map("user_id")
  entity      String   @db.VarChar(64)
  entityId    BigInt?  @map("entity_id")
  action      String   @db.VarChar(64)
  changesJson Json?    @map("changes_json")
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_audit_user")

  @@index([userId, createdAt], map: "idx_audit_user_created")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([action, createdAt], map: "idx_audit_action_created")
  @@map("audit_log")
}

// ── accounts ─────────────────────────────────────────────────────────────────
// Medios de pago. El saldo NO se almacena: se deriva de opening_balance más la
// suma firmada de los movimientos. Las cuentas con historial se archivan
// (is_archived), nunca se borran.

model Account {
  id             BigInt      @id @default(autoincrement())
  userId         BigInt      @map("user_id")
  name           String      @db.VarChar(255)
  type           AccountType @default(other)
  currency       String      @default("COP") @db.Char(3)
  institution    String?     @db.VarChar(255)
  last4          String?     @db.Char(4)
  creditLimit    Decimal?    @map("credit_limit") @db.Decimal(15, 2)
  cutoffDay      Int?        @map("cutoff_day") @db.SmallInt
  paymentDay     Int?        @map("payment_day") @db.SmallInt
  openingBalance Decimal     @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  isArchived     Boolean     @default(false) @map("is_archived")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamp(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_accounts_user")
  transactions  Transaction[]
  importBatches ImportBatch[]

  @@index([userId, isArchived], map: "idx_accounts_user_archived")
  @@map("accounts")
}

// ── categories ───────────────────────────────────────────────────────────────
// Taxonomía editable del usuario, jerarquía de 1 nivel (hasta 2) vía parent_id.
// Se archivan, no se borran. Si aun así se borrara una, las transacciones
// sobreviven SIN categoría (SetNull) — coherente con la no-rigidez.

model Category {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt       @map("user_id")
  name       String       @db.VarChar(255)
  parentId   BigInt?      @map("parent_id")
  kind       CategoryKind @default(expense)
  color      String?      @db.Char(7)
  icon       String?      @db.VarChar(64)
  sortOrder  Int          @default(0) @map("sort_order")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_categories_user")
  parent       Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, map: "fk_categories_parent")
  children     Category[]         @relation("CategoryTree")
  transactions Transaction[]
  importRows   ImportRow[]
  rules        CategoryRule[]
  splits       TransactionSplit[]

  @@index([userId, kind, parentId], map: "idx_categories_user_kind_parent")
  @@map("categories")
}

// ── tags ─────────────────────────────────────────────────────────────────────
// Etiquetas libres y transversales ("reembolsable", "viaje-cartagena"). A
// diferencia de las categorías —que son la taxonomía vertical y única— una
// etiqueta cruza cualquier categoría, cuenta o tipo, y un movimiento puede
// llevar varias.
//
// El unique (user_id, name) permite un "get-or-create" idempotente: la UI las
// crea al vuelo mientras el usuario escribe, sin pedir permiso.

model Tag {
  id     BigInt  @id @default(autoincrement())
  userId BigInt  @map("user_id")
  name   String  @db.VarChar(255)
  color  String? @db.Char(7)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tags_user")
  transactions TransactionTag[]

  @@unique([userId, name], map: "uq_tags_user_name")
  @@map("tags")
}

// ── transactions ─────────────────────────────────────────────────────────────
// EL NÚCLEO. Todo lo demás se deriva de aquí.
// `amount` se almacena SIEMPRE positivo; el signo económico lo da `type`.
// `category_id` es NULL-able a propósito: un movimiento puede existir sin
// categoría y eso jamás bloquea el guardado.
//
// account_id es Restrict (no se borra una cuenta con movimientos: se archiva).
// category_id es SetNull (enriquecimiento opcional que no destruye el movimiento).
//
// recurring_concept_id e import_batch_id llegan en sus fases (3 y 2); se añaden
// como migraciones nuevas, nunca reescribiendo una ya aplicada.

model Transaction {
  id              BigInt             @id @default(autoincrement())
  uuid            String             @unique(map: "uq_transactions_uuid") @default(uuid()) @db.Char(36)
  userId          BigInt             @map("user_id")
  /// OPCIONAL a propósito.
  ///
  /// Llevar cuentas —tarjetas, ahorros, efectivo— es una función que se
  /// enciende en los ajustes, no un requisito para registrar un gasto. Quien
  /// solo quiere saber cuánto gastó este mes no debería tener que inventarse
  /// una cuenta primero.
  ///
  /// La consecuencia hay que asumirla de frente: un movimiento sin cuenta no
  /// participa de ningún saldo. Los saldos siguen siendo exactos para las
  /// cuentas que existan, y sencillamente no hay saldo para lo demás.
  accountId       BigInt?            @map("account_id")
  date            DateTime           @db.Date
  amount          Decimal            @db.Decimal(15, 2)
  type            TransactionType    @default(expense)
  categoryId      BigInt?            @map("category_id")
  description     String?            @db.VarChar(255)
  merchant        String?            @db.VarChar(255)
  notes           String?            @db.Text
  transferGroupId String?            @map("transfer_group_id") @db.Char(36)
  transferDir     TransferDirection? @map("transfer_direction")
  /// Huella del movimiento cuando vino de una importación. Sirve para detectar
  /// repeticiones en importaciones futuras. NO lleva UNIQUE a propósito: dos
  /// cafés de $5.000 el mismo día en el mismo sitio son dos movimientos reales,
  /// y un constraint rechazaría el segundo. Se informa, no se bloquea.
  externalRef     String?            @map("external_ref") @db.VarChar(255)
  /// De qué importación salió, si salió de alguna. Es lo que permite deshacer
  /// un lote entero sin borrar cuarenta movimientos a mano.
  importBatchId   BigInt?            @map("import_batch_id")
  status          TransactionStatus  @default(cleared)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamp(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tx_user")
  account  Account?           @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_tx_account")
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_tx_category")
  splits   TransactionSplit[]
  tags     TransactionTag[]

  /// SetNull y no Cascade: borrar el registro de una importación no puede
  /// llevarse por delante movimientos que la persona ya dio por buenos.
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull, map: "fk_tx_import_batch")
  posiblesCopias ImportRow[]  @relation("PosibleDuplicado")

  @@index([userId, importBatchId], map: "idx_tx_user_import_batch")
  @@index([userId, date], map: "idx_tx_user_date")
  @@index([userId, categoryId], map: "idx_tx_user_category")
  @@index([accountId, date], map: "idx_tx_account_date")
  @@index([userId, externalRef], map: "idx_tx_user_external_ref")
  @@index([transferGroupId], map: "idx_tx_transfer_group")
  @@map("transactions")
}

// ── transaction_splits ───────────────────────────────────────────────────────
// Reparte un movimiento entre varias categorías (una compra de supermercado que
// es 70% mercado y 30% aseo).
//
// INVARIANTE INVIOLABLE: la suma de los splits debe igualar EXACTAMENTE el
// `amount` de la transacción. MySQL/MariaDB no puede expresar esa suma como
// constraint declarativo, así que la valida el servicio con Prisma.Decimal
// dentro del $transaction, antes de confirmar. Si no cuadra: 422 y ROLLBACK.
//
// Cuando un movimiento tiene splits, la agregación por categoría consume los
// splits, no el category_id de cabecera.

model TransactionSplit {
  id            BigInt  @id @default(autoincrement())
  transactionId BigInt  @map("transaction_id")
  categoryId    BigInt? @map("category_id")
  amount        Decimal @db.Decimal(15, 2)
  note          String? @db.VarChar(255)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, map: "fk_splits_tx")
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_splits_category")

  @@index([transactionId], map: "idx_splits_transaction")
  @@map("transaction_splits")
}

// ── transaction_tags ─────────────────────────────────────────────────────────
// Puente N:M entre movimientos y etiquetas. La PK compuesta impide duplicados y
// hace de índice a la vez. CASCADE por ambos lados: al borrar el movimiento o
// la etiqueta, la relación desaparece sola.

model TransactionTag {
  transactionId BigInt @map("transaction_id")
  tagId         BigInt @map("tag_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, map: "fk_tt_tx")
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "fk_tt_tag")

  @@id([transactionId, tagId])
  @@index([tagId], map: "idx_tt_tag")
  @@map("transaction_tags")
}

// ── import_batches (M4) ──────────────────────────────────────────────────────
// Un documento leído: un screenshot, un PDF de extracto, un pegado de texto.
//
// QUÉ NO SE GUARDA AQUÍ, a propósito: ni la imagen, ni el PDF, ni el texto
// crudo del OCR. Todo el beneficio de hacer OCR en el navegador es que el
// extracto NUNCA sale del equipo del usuario (análisis 5.6); subirlo al
// servidor destruiría exactamente eso. Lo que se guarda son las filas ya
// parseadas, que es lo que la persona va a revisar.
//
// El lote sobrevive al commit porque es lo que permite DESHACER: sin él, una
// importación mal parseada solo se arregla borrando cuarenta movimientos a
// mano.

model ImportBatch {
  id          BigInt       @id @default(autoincrement())
  uuid        String       @unique(map: "uq_import_batches_uuid") @default(uuid()) @db.Char(36)
  userId      BigInt       @map("user_id")
  /// Opcional, por lo mismo que en transactions: se puede importar un extracto
  /// sin declarar a qué cuenta pertenece.
  accountId   BigInt?      @map("account_id")
  source      ImportSource @default(image)
  status      ImportStatus @default(draft)
  /// Nombre del archivo, solo para que la persona reconozca el lote. Nunca su contenido.
  label       String?      @db.VarChar(255)
  /// Qué implementación de OcrProvider lo produjo. Sirve para comparar calidad
  /// el día que exista una alternativa de servidor.
  ocrProvider String?      @map("ocr_provider") @db.VarChar(64)
  committedAt DateTime?    @map("committed_at") @db.Timestamp(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_import_batch_user")
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_import_batch_account")
  rows         ImportRow[]
  transactions Transaction[]

  @@index([userId, status], map: "idx_import_batch_user_status")
  @@map("import_batches")
}

// ── import_rows (M4) ─────────────────────────────────────────────────────────
// Una línea candidata del documento. Vive en `draft` mientras se revisa y no
// toca las finanzas del usuario hasta que el lote se confirma.
//
// `amount` es Decimal como cualquier otro dinero de la app: parsear a `number`
// aquí y convertir después ya habría perdido centavos.

model ImportRow {
  id            BigInt          @id @default(autoincrement())
  batchId       BigInt          @map("batch_id")
  /// Orden en el documento. Revisar en desorden es desorientador.
  position      Int
  date          DateTime        @db.Date
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType @default(expense)
  description   String?         @db.VarChar(255)
  status        ImportRowStatus @default(pending)
  /// Categoría sugerida por T1. Es una SUGERENCIA: la persona la cambia o la quita.
  categoryId    BigInt?         @map("category_id")
  /// 0–100. Se muestra para que se sepa cuánto fiarse de la sugerencia.
  confidence    Int?            @db.SmallInt
  /// Huella determinista para detectar repeticiones. Ver `fingerprint.ts`.
  fingerprint   String          @db.Char(64)
  /// Si se sospecha repetición, a qué movimiento ya existente se parece.
  duplicateOfId BigInt?         @map("duplicate_of_id")

  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade, map: "fk_import_row_batch")
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_import_row_category")
  duplicateOf Transaction? @relation("PosibleDuplicado", fields: [duplicateOfId], references: [id], onDelete: SetNull, map: "fk_import_row_duplicate")

  @@index([batchId, position], map: "idx_import_row_batch_position")
  @@map("import_rows")
}

// ── category_rules (T1) ──────────────────────────────────────────────────────
// Reglas de categorización automática: "si la descripción contiene X, sugiere
// la categoría Y".
//
// Son SUGERENCIAS. El principio de no-rigidez del producto manda: el sistema
// informa, nunca bloquea, y un movimiento sin categoría siempre se puede
// guardar.
//
// Además de estas reglas explícitas, el servicio aprende del historial del
// propio usuario, que es la señal más fuerte y no exige mantener listas.

model CategoryRule {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  /// Fragmento a buscar en la descripción, ya en minúsculas y sin tildes.
  pattern    String   @db.VarChar(120)
  categoryId BigInt   @map("category_id")
  /// Mayor prioridad gana cuando varias reglas coinciden. Las creadas por la
  /// persona pesan más que las sembradas por defecto.
  priority   Int      @default(0)
  /// Cuántas veces ha acertado. Sube cuando se acepta la sugerencia.
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_rule_user")
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "fk_rule_category")

  @@unique([userId, pattern], map: "uq_rule_user_pattern")
  @@index([userId, priority], map: "idx_rule_user_priority")
  @@map("category_rules")
}

// ── user_preferences (T5) ────────────────────────────────────────────────────
// Almacén clave-valor por usuario. pref_value es JSON para admitir estructuras
// arbitrarias sin migrar el esquema. El unique (user_id, pref_key) habilita un
// upsert idempotente.
//
// Nota MariaDB: implementa JSON como LONGTEXT con un CHECK de validez, no como
// tipo nativo. Funciona igual para almacenar y leer; se verifica en la primera
// migración.

model UserPreference {
  id        BigInt @id @default(autoincrement())
  userId    BigInt @map("user_id")
  prefKey   String @map("pref_key") @db.VarChar(64)
  prefValue Json   @map("pref_value")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_pref_user")

  @@unique([userId, prefKey], map: "uq_pref_user_key")
  @@map("user_preferences")
}
