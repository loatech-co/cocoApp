# ─────────────────────────────────────────────────────────────
# api/.env.example — plantilla SIN valores reales.
# El .env real está en .gitignore y NUNCA se commitea (PRD 23.10).
# Lo carga @nestjs/config; los consumidores usan ConfigService.getOrThrow().
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Base de datos (Prisma) ───────────────────────────────────
# Motor: MariaDB. Prisma la trata con provider = "mysql" (análisis 5.1).
# Usuario de RUNTIME, con mínimo privilegio: solo SELECT/INSERT/UPDATE/DELETE.
# connection_limit bajo (5–10) por el max_user_connections de MariaDB
# compartida en Hostinger (análisis 4.3 y 9).
DATABASE_URL="mysql://coco_app:__CAMBIAR__@127.0.0.1:3306/coco_dev?connection_limit=5"

# ── Autenticación ────────────────────────────────────────────
# Firma de los access tokens. Genera uno con:  openssl rand -base64 48
# Cambiarlo invalida TODAS las sesiones abiertas.
JWT_SECRET="__CAMBIAR__"

# Quien se registre con este correo nace administrador y activo. Se hace así, y
# no "el primer registro gana", porque si la app estuviera desplegada antes de
# que el dueño se registre, cualquiera se llevaría el panel.
BOOTSTRAP_ADMIN_EMAIL="tu-correo@ejemplo.com"

# Contraste contra la base de contraseñas filtradas (Have I Been Pwned).
# Ponlo en "false" solo en entornos sin salida a internet.
CHECK_BREACHED_PASSWORDS=true

# ── CORS ─────────────────────────────────────────────────────
# Solo el origen exacto del frontend. Sin comodines (PRD 6.9).
# Varios orígenes separados por coma.
CORS_ORIGINS="http://localhost:5173"

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
