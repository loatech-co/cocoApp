# ─────────────────────────────────────────────────────────────────────────────
# api/.env.example — plantilla SIN valores.
#
# El `.env` real está en .gitignore y nunca se commitea. Lo carga
# `@nestjs/config` con una ruta ABSOLUTA derivada de `__dirname`, no del
# directorio de trabajo: el hosting arranca el proceso en el HOME del usuario.
#
# The API validates these at boot against ONE schema, `src/common/config/env.ts`,
# and refuses to start with a list of what is missing or invalid. This file
# lists exactly the variables of that schema, no more and no fewer; a test
# (`env.spec.ts`) fails otherwise. What only the scripts read lives in
# `.env.migrate.example`.
#
# ── Nombres viejos, en transición (paso 7.2-r3) ──────────────────────────────
# Cinco variables pasaron a inglés: SOPORTES_DIR → RECEIPTS_DIR,
# SOPORTES_STORAGE → RECEIPTS_STORAGE, SOPORTES_BUCKET → RECEIPTS_BUCKET,
# PERMITIR_BASE_REMOTA → ALLOW_REMOTE_DATABASE y PERMITIR_AUTH_DESTRUCTIVA →
# ALLOW_DESTRUCTIVE_AUTH. Los valores no cambian (`si` sigue siendo `si`).
# Hasta la contracción (7.10) la API lee el nombre viejo si falta el nuevo y lo
# avisa en el log; si están los dos con valores distintos, gana el nuevo. Un
# `.env` local con los nombres viejos sigue arrancando: renómbralos cuando
# puedas.
#
# ── En LOCAL esto apunta a la base LOCAL ─────────────────────────────────────
# Nunca a Supabase. La base de producción se usa solo desde archivos
# explícitos —`.env.supabase` para migraciones, `.env.migrate` para la local—
# y jamás por defecto. La API se niega a arrancar si detecta lo contrario
# (ver `whyRefuseToStart` en `src/common/env.ts`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
# `development`, `test` o `production`. Fuera de producción se exige base local.
NODE_ENV=
# `si` levanta esa exigencia. Es la válvula de escape para cuando apuntar a una
# base remota es deliberado; cualquier otro valor no cuenta.
ALLOW_REMOTE_DATABASE=
# Puerto en el que escucha la API.
PORT=
# `debug`, `log`, `warn` o `error`.
LOG_LEVEL=
# Carpeta del archivo de logs JSON (`api.log`, rotado). Sin ella: en producción
# `~/logs/coco-api` (fuera de la carpeta de la versión, que cada despliegue
# reemplaza); fuera de producción, solo la consola.
LOG_DIR=

# ── Base de datos ────────────────────────────────────────────────────────────
# Postgres por el que entra la aplicación, como el rol `coco_app` (sin
# BYPASSRLS; lo crea scripts/db/create-app-role.sh). En Supabase, por el pooler
# el usuario es `coco_app.<project-ref>`. Ver docs/runbook.md, "Row-level security".
DATABASE_URL=
# Conexión DIRECTA, sin pooler, como el DUEÑO de las tablas (con BYPASSRLS).
# La usan las migraciones de Prisma.
DIRECT_URL=

# ── Supabase Auth ────────────────────────────────────────────────────────────
# URL del proyecto. De aquí salen el endpoint de GoTrue y el JWKS que verifica
# los tokens.
SUPABASE_URL=
# Clave pública. Se usa para las operaciones a nombre de quien ha entrado.
SUPABASE_ANON_KEY=
# Clave de servicio. SECRETA: crea usuarios, cambia contraseñas y revoca
# sesiones. Nunca sale del backend ni entra a un bundle del frontend.
SUPABASE_SERVICE_ROLE_KEY=
# `si` permite crear, borrar y cambiarle la contraseña a cuentas REALES desde
# una sesión que no es de producción. Apagado, esas cuatro operaciones se
# niegan; entrar sigue funcionando. Se enciende el día que haya un proyecto de
# Supabase aparte para desarrollo.
ALLOW_DESTRUCTIVE_AUTH=

# ── Sesión y acceso ──────────────────────────────────────────────────────────
# Quien se registre con este correo nace administrador y activo. RIESGO: el
# registro no verifica el correo, así que cualquiera que lo escriba primero es
# admin. Ponla solo para crear el primer admin y vacíala en cuanto exista.
# Aquí va vacía, siempre.
BOOTSTRAP_ADMIN_EMAIL=
# `true` contrasta las contraseñas contra la base de filtradas. Ponlo en
# `false` solo en entornos sin salida a internet.
CHECK_BREACHED_PASSWORDS=
# Orígenes exactos del frontend, separados por coma. Sin comodines.
CORS_ORIGINS=
# Cuántos proxies hay delante de la API (LiteSpeed es uno). Vacía = 1. De
# ella sale la IP del cliente que ven el limitador y `audit_log`; con un CDN
# delante serían 2. Nunca más de los que hay: la IP pasaría a ser la que el
# cliente escriba en `X-Forwarded-For`.
TRUST_PROXY_HOPS=
# `true` registra la FORMA de las cabeceras de proxy (cuántas entradas, cuál
# coincide con `X-Real-IP`; nunca una IP) en las 20 primeras peticiones de cada
# proceso. Diagnóstico temporal para confirmar TRUST_PROXY_HOPS; vacía después.
LOG_PROXY_HEADERS=

# ── Soportes (los recibos adjuntos) ──────────────────────────────────────────
# Carpeta del almacén, FUERA del árbol web. En local, una carpeta del
# repositorio para que la base y los archivos vivan en el mismo entorno; sin
# ella se cae a `api/.soportes`.
RECEIPTS_DIR=
# Dónde viven los archivos: `supabase` (bucket privado de Supabase Storage, con
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY) o `disk` (RECEIPTS_DIR). Sin ella:
# `supabase` en producción y `disk` en todo lo demás.
RECEIPTS_STORAGE=
# Nombre del bucket. `soportes` por defecto: cambió el nombre de la variable,
# no el del bucket (ADR 0026).
RECEIPTS_BUCKET=
# En pruebas: `on` enciende la tarea diaria de cobros automáticos, que con
# NODE_ENV=test está apagada (las e2e la llaman a mano).
AUTO_CHARGE=

# ── Estáticos ────────────────────────────────────────────────────────────────
# Carpeta del frontend ya compilado, para servirlo desde la propia API. Solo
# hace falta cuando los dos van juntos en el mismo proceso.
SPA_DIST_PATH=

# ── Feature flags ────────────────────────────────────────────────────────────
# Flags encendidas para TODOS los usuarios, separadas por comas
# (`flag_a,flag_b`). Cada nombre tiene que estar en
# packages/flags/src/registry.ts: con uno desconocido la API no arranca. Para
# un solo usuario no va aquí: va en user_preferences con la clave
# `feature:<nombre>` (ver CONTRIBUTING.md, «Feature flags»).
FEATURES=
