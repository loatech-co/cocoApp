{
  "name": "coco-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coco App — Finanzas personales. Monorepo: frontend (React 19 + Vite) + api (NestJS 11 + Prisma) + tipos compartidos.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "api",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && eslint e2e --max-warnings 0 && npm run lint:spanish",
    "lint:spanish": "tsx scripts/lint/spanish-identifiers.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "e2e:build": "npm run build --workspace api && npm run build --workspace frontend",
    "e2e": "playwright test -c e2e",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace frontend",
    "dev:auth": "node scripts/dev-auth.mjs",
    "prepare:ocr": "node scripts/prepare-tesseract.mjs",
    "seed:local": "dotenv -e api/.env.migrate -- tsx scripts/seed-local.mjs",
    "sql": "dotenv -e api/.env.migrate -- tsx scripts/sql.mjs",
    "sql:supabase": "dotenv -e api/.env.migrate -- bash scripts/sql-supabase.sh",
    "postinstall": "node scripts/prepare-tesseract.mjs && npm run build --workspace @coco/receipt-parser --workspace @coco/flags",
    "start": "node api/dist/main.js",
    "backup": "bash scripts/backup.sh",
    "verify:clean-install": "bash scripts/verify-clean-install.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "depcruise": "depcruise api/src frontend/src packages/receipt-parser/src packages/flags/src --config .dependency-cruiser.cjs && node scripts/ci/table-ownership.mjs",
    "prepare": "[ -n \"$CI\" ] || [ \"$NODE_ENV\" = production ] || lefthook install || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.24.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.5.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "knip": "^6.39.0",
    "lefthook": "^2.1.17",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "tsx": "~4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    },
    "brace-expansion@1": "1.1.21",
    "undici@7": "7.29.1"
  }
}
