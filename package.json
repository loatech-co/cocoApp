{
  "name": "coco-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coco App — Finanzas personales. Monorepo: frontend (React 19 + Vite) + api (NestJS 11 + Prisma) + tipos compartidos.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "api",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace frontend",
    "prepare:ocr": "node scripts/preparar-tesseract.mjs",
    "sembrar:local": "dotenv -e api/.env.migrate -- node scripts/sembrar-local.mjs",
    "sql": "dotenv -e api/.env.migrate -- node scripts/sql.mjs",
    "sql:supabase": "dotenv -e api/.env.migrate -- bash scripts/sql-supabase.sh",
    "postinstall": "node scripts/preparar-tesseract.mjs && npm run build --workspace @coco/lectura --workspace @coco/flags",
    "start": "node api/dist/main.js",
    "deploy:web": "bash scripts/desplegar-frontend.sh",
    "deploy:api": "bash scripts/desplegar-api.sh",
    "respaldar": "bash scripts/respaldar.sh",
    "verify:clean-install": "bash scripts/verify-clean-install.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "depcruise": "depcruise api/src frontend/src packages/types/src packages/lectura/src packages/flags/src --config .dependency-cruiser.cjs && node scripts/ci/table-ownership.mjs",
    "prepare": "[ -n \"$CI\" ] || [ \"$NODE_ENV\" = production ] || lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.24.4",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.1.0",
    "dependency-cruiser": "^18.5.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.17",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "tsx": "~4.20.6",
    "typescript-eslint": "^8.71.1"
  }
}
