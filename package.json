{
  "name": "coco-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coco App — Finanzas personales. Monorepo: frontend (React 19 + Vite) + api (NestJS 11 + Prisma) + tipos compartidos.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "api",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace frontend",
    "prepare:ocr": "node scripts/preparar-tesseract.mjs",
    "sembrar:local": "dotenv -e api/.env.migrate -- node scripts/sembrar-local.mjs",
    "sql": "dotenv -e api/.env.migrate -- node scripts/sql.mjs",
    "sql:supabase": "dotenv -e api/.env.migrate -- bash scripts/sql-supabase.sh",
    "postinstall": "node scripts/preparar-tesseract.mjs && npm run build --workspace @coco/lectura",
    "start": "node api/dist/main.js",
    "deploy:web": "bash scripts/desplegar-frontend.sh",
    "deploy:api": "bash scripts/desplegar-api.sh",
    "respaldar": "bash scripts/respaldar.sh",
    "cargar": "dotenv -e api/.env.supabase -- node scripts/cargar-historico.mjs",
    "soportes:reporte": "node scripts/soportes/reporte.mjs",
    "soportes:importar": "dotenv -e api/.env -- node scripts/soportes/importar.mjs",
    "soportes:sincronizar": "bash scripts/soportes/sincronizar.sh",
    "verify:clean-install": "bash scripts/verify-clean-install.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.24.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "~4.20.6",
    "typescript-eslint": "^8.71.1"
  }
}
