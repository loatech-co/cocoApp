# https://editorconfig.org — the editor-side half of the formatting rules.
# Prettier (.prettierrc.json) is the source of truth for JS/TS/CSS/JSON/MD/YAML;
# this file covers what Prettier does not touch (shell, SQL, Prisma, Swift).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[Makefile]
indent_style = tab
